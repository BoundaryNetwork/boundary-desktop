{
  "name": "@boundary-desktop/contract",
  "version": "0.4.0",
  "description": "基座 ⇄ module 共同契约:类型 + 极少运行期辅助(单一事实来源)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
